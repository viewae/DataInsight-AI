SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/datainsight
REDIS_URL=redis://localhost:6379/0
# 本地默认在项目 backend 目录下创建 uploads/；Docker 见 compose 中的 UPLOAD_DIR
UPLOAD_DIR=uploads

# DeepSeek（OpenAI 兼容）：https://api.deepseek.com
# 密钥可不写进文件：在系统/IDE 里配置任一名即可 — LLM_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY
LLM_API_BASE=https://api.deepseek.com
# LLM_API_KEY=
# 默认与官方全名一致；若线路不同可改为 deepseek-chat 等
LLM_MODEL=deepseek-v4-pro
